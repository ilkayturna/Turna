    "axios": "^1.13.5",
    "axios-cookiejar-support": "^6.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "groq-sdk": "^1.1.1",
    "lucide-react": "^0.574.0",
    "playwright": "^1.60.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
